FROM node:26.12.1-trixie-slim@sha256:94816674c62774da0d099a947bf4613b9e1972a2733abd0d0cd80e795f8411d0 AS build-base
RUN apt-get update \
    && apt-get install -y --no-install-recommends --only-upgrade zlib1g=1:1.3.dfsg+really1.3.1-1+deb13u1 \
    && test "$(dpkg-query -W -f='${Version}' zlib1g)" = "1:1.3.dfsg+really1.3.1-1+deb13u1" \
    && rm -rf /var/lib/apt/lists/*

FROM build-base AS build
WORKDIR /app
ARG PREDICTIR_BUILD_MODE=replay
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
RUN --mount=type=cache,id=predictir-public-npm,target=/root/.npm npm ci --ignore-scripts --prefer-offline --no-audit --no-fund
COPY . .
RUN case "$PREDICTIR_BUILD_MODE" in replay|live) ;; *) exit 1 ;; esac \
    && NODE_OPTIONS=--max-old-space-size=1024 PREDICTIR_MODE="$PREDICTIR_BUILD_MODE" node node_modules/next/dist/bin/next typegen \
    && NODE_OPTIONS=--max-old-space-size=1024 npm run typecheck -- --incremental false
RUN NODE_OPTIONS=--max-old-space-size=1024 PREDICTIR_SEPARATE_TYPECHECK=1 PREDICTIR_MODE="$PREDICTIR_BUILD_MODE" npm run build -- --webpack \
    && printf '%s\n' "$PREDICTIR_BUILD_MODE" > .predictir-edition

FROM build-base AS geography
ADD --checksum=sha256:75fe430010f6d38a8c4331c202bf0df6ce3221a6e6d823b9e5a6d951e4cf9758 https://download.db-ip.com/free/dbip-country-lite-2026-11.mmdb.gz /country.mmdb.gz
RUN node -e "const fs = require('node:fs'); fs.writeFileSync('/country.mmdb', require('node:zlib').gunzipSync(fs.readFileSync('/country.mmdb.gz')))"

FROM gcr.io/distroless/nodejs26-debian13@sha256:9b945e92c1b5463a4b75f11e8417515e4bea7355f6adfd79ec220fbbe905dda8 AS node-runtime
FROM gcr.io/distroless/base-nossl-debian13@sha256:e6b0f82595aa1edde72c8054de7a9dca30f0f8f54820c37a167c0ddfc21c5c67 AS runtime
ENV PATH=/nodejs/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
COPY --from=node-runtime /nodejs /nodejs
COPY --from=node-runtime /usr/lib/*-linux-gnu/libatomic.so.1* /usr/lib/*-linux-gnu/libgcc_s.so.1 /usr/lib/*-linux-gnu/libgomp.so.1* /usr/lib/*-linux-gnu/libstdc++.so.6* /usr/lib/
COPY --from=node-runtime /var/lib/dpkg/status.d/gcc-14-base /var/lib/dpkg/status.d/libatomic1 /var/lib/dpkg/status.d/libgcc-s1 /var/lib/dpkg/status.d/libgomp1 /var/lib/dpkg/status.d/libstdc++6 /var/lib/dpkg/status.d/
COPY --from=node-runtime /usr/share/doc/gcc-14-base /usr/share/doc/gcc-14-base
COPY --from=node-runtime /usr/share/doc/libatomic1 /usr/share/doc/libatomic1
COPY --from=node-runtime /usr/share/doc/libgcc-s1 /usr/share/doc/libgcc-s1
COPY --from=node-runtime /usr/share/doc/libgomp1 /usr/share/doc/libgomp1
COPY --from=node-runtime /usr/share/doc/libstdc++6 /usr/share/doc/libstdc++6

FROM runtime AS front
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000
ENV AZURE_COUNTRY_DB=/app/country.mmdb
COPY --from=geography --chown=65532:65532 /country.mmdb ./country.mmdb
COPY --from=build --chown=65532:65532 /app/.next/standalone ./
COPY --from=build --chown=65532:65532 /app/.next/static ./.next/static
COPY --from=build --chown=65532:65532 /app/public ./public
COPY --from=build --chown=65532:65532 /app/.predictir-edition ./.predictir-edition
COPY --chown=65532:65532 cloud/azure-front.mjs ./cloud/azure-front.mjs
COPY --chown=65532:65532 lib/workspace/azure-mode.mjs ./lib/workspace/azure-mode.mjs
USER 65532:65532
EXPOSE 3000
ENTRYPOINT ["/nodejs/bin/node"]
CMD ["cloud/azure-front.mjs"]

FROM build-base AS backend-dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=cache,id=predictir-public-npm,target=/root/.npm npm pkg delete dependencies.next dependencies.react dependencies.react-dom dependencies.lucide-react dependencies.uplot dependencies.payload 'dependencies.@payloadcms/db-sqlite' \
    && npm ci --omit=dev --ignore-scripts --prefer-offline --no-audit --no-fund \
    && mkdir -p /tmp/market-lab-models

FROM runtime AS backend
WORKDIR /app
ENV NODE_ENV=production PORT=8780 SEMANTIC_MODEL_CACHE_DIR=/tmp/market-lab-models
COPY --from=backend-dependencies --chown=65532:65532 /app/package.json /app/package-lock.json ./
COPY --from=backend-dependencies --chown=65532:65532 /app/node_modules ./node_modules
COPY --from=backend-dependencies --chown=65532:65532 /tmp/market-lab-models /tmp/market-lab-models
COPY --chown=65532:65532 app/api ./app/api
COPY --chown=65532:65532 lib ./lib
COPY --chown=65532:65532 cloud ./cloud
COPY --chown=65532:65532 public ./public
COPY --chown=65532:65532 database ./database
COPY --chown=65532:65532 research-data ./research-data
USER 65532:65532
EXPOSE 8780
ENTRYPOINT ["/nodejs/bin/node"]
CMD ["--max-old-space-size=384", "cloud/azure.mjs"]
